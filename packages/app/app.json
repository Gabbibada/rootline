{
  "expo": {
    "name": "Rootline",
    "slug": "rootline",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rootline",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1008"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gabbibada.rootline",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gabbibada.rootline",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1008"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rootline to access your photos to set profile pictures."
        }
      ]
    ],
    "sdkVersion": "54.0.0",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "998259e5-1664-4aa9-bbb3-08d007fcc348"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/998259e5-1664-4aa9-bbb3-08d007fcc348"
    }
  }
}
