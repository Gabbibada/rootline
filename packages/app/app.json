{
  "expo": {
    "name": "Rootline",
    "slug": "rootline",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rootline",

    "icon": "./assets/icon.png",

    "splash": {
      "image":           "./assets/splash.png",
      "resizeMode":      "contain",
      "backgroundColor": "#1C1008"
    },

    "ios": {
      "supportsTablet":   false,
      "bundleIdentifier": "com.gabbibada.rootline"
    },
    "android": {
      "package":          "com.gabbibada.rootline",
      "adaptiveIcon": {
        "foregroundImage":  "./assets/icon.png",
        "backgroundColor":  "#1C1008"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      ["expo-image-picker", {
        "photosPermission": "Allow Rootline to access your photos to set profile pictures."
      }]
    ],

    "sdkVersion": "54.0.0",
    "experiments": { "typedRoutes": true }
  }
}
